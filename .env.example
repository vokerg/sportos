DATABASE_URL=postgres://sportos_app:sportos_app@localhost:5432/sportos
SPORTOS_WORKER_DATABASE_URL=postgres://sportos_worker:sportos_worker@localhost:5432/sportos
SPORTOS_LEGACY_DATABASE_URL=postgres://sportos_legacy:sportos_legacy@localhost:5432/sportos
REDIS_URL=redis://localhost:6379
API_PORT=3000
WEB_PORT=4200
SPORTOS_WEB_ORIGIN=http://localhost:4200
SPORTOS_API_ORIGIN=http://localhost:3000
SPORTOS_UPLOAD_DIR=./data/uploads
IMPORT_DIR=./data/imports
IMPORT_WORKER_CONCURRENCY=1
IMPORT_JOB_LEASE_SECONDS=60
IMPORT_JOB_POLL_MS=1000

# OIDC Authorization Code + PKCE. Do not commit deployed secrets.
SPORTOS_OIDC_ISSUER=https://identity.example.com
SPORTOS_OIDC_CLIENT_ID=sportos-local
SPORTOS_OIDC_CLIENT_SECRET=
SPORTOS_SESSION_IDLE_SECONDS=43200
SPORTOS_SESSION_ABSOLUTE_SECONDS=604800
SPORTOS_COOKIE_SECURE=false

# Optional local-only session bootstrap. Leave empty outside isolated development.
SPORTOS_DEV_AUTH_TOKEN=
