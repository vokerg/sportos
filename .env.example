DATABASE_URL=postgres://sportos_app:sportos_app@localhost:5432/sportos
SPORTOS_WORKER_DATABASE_URL=postgres://sportos_worker:sportos_worker@localhost:5432/sportos
SPORTOS_WORKER_DATA_DATABASE_URL=postgres://sportos_worker_data:sportos_worker_data@localhost:5432/sportos
SPORTOS_LEGACY_DATABASE_URL=postgres://sportos_legacy:sportos_legacy@localhost:5432/sportos
REDIS_URL=redis://localhost:6379
API_PORT=3000
WEB_PORT=4200
SPORTOS_WEB_ORIGIN=http://localhost:4200
SPORTOS_API_ORIGIN=http://localhost:3000
SPORTOS_UPLOAD_DIR=./data/uploads
IMPORT_DIR=./data/imports
IMPORT_WORKER_CONCURRENCY=1
IMPORT_JOB_LEASE_SECONDS=60
IMPORT_JOB_POLL_MS=1000

# Local development uses the fixed legacy account without browser login/cookies.
# Leave unset for normal OIDC-authenticated deployments.
SPORTOS_AUTH_MODE=dev-single-user

# OIDC Authorization Code + PKCE. Do not commit deployed secrets.
SPORTOS_OIDC_ISSUER=https://identity.example.com
SPORTOS_OIDC_CLIENT_ID=sportos-local
SPORTOS_OIDC_CLIENT_SECRET=
SPORTOS_SESSION_IDLE_SECONDS=43200
SPORTOS_SESSION_ABSOLUTE_SECONDS=604800
SPORTOS_COOKIE_SECURE=false

# Optional one-time mapping for pre-account local data. Set both values before
# the intended owner's first OIDC login, then keep them stable until verified.
SPORTOS_LEGACY_OIDC_ISSUER=
SPORTOS_LEGACY_OIDC_SUBJECT=

# Optional local-only session bootstrap. Leave empty outside isolated development.
SPORTOS_DEV_AUTH_TOKEN=

# Strava OAuth and provider ingestion. Register this exact callback URL with Strava.
# Keep client secrets and credential-encryption keys outside source control.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/providers/strava/callback

# Optional endpoint overrides for controlled testing or an official API host change.
STRAVA_AUTH_BASE_URL=https://www.strava.com
STRAVA_API_BASE_URL=https://www.strava.com

# Comma-separated keyId:base64-encoded-32-byte-key entries. The active key encrypts
# new/rotated credentials; retained old keys decrypt existing envelopes during rotation.
# Example key generation: openssl rand -base64 32
SPORTOS_PROVIDER_CREDENTIAL_KEYS=
SPORTOS_PROVIDER_ACTIVE_KEY_ID=

# Optional external JSON generator for read-only analysis. Leave the endpoint and
# model empty to use the deterministic local fallback only. HTTPS is required except
# for localhost development. The API key is sent only as a Bearer token to this endpoint.
SPORTOS_AI_JSON_ENDPOINT=
SPORTOS_AI_MODEL=
SPORTOS_AI_API_KEY=
SPORTOS_AI_TIMEOUT_MS=15000
