# Copy privately to /opt/sportos-oracle/api.env, mode 600.
# No Flyway, dispatcher, worker-data or legacy credentials here.
DATABASE_URL=postgresql://sportos_app:REPLACE@PRIMARY/neondb?sslmode=require
SPORTOS_ACTIVITY_DETAIL_DATABASE_URL=postgresql://sportos_app:REPLACE@DETAIL/sportos_activity_detail?sslmode=require
SPORTOS_AUTH_MODE=single-user
SPORTOS_SINGLE_USER_USERNAME=REPLACE
SPORTOS_SINGLE_USER_PASSWORD_HASH=REPLACE
# Production validation requires HTTPS. Tunnel smoke checks only test liveness;
# authenticated use requires a reviewed HTTPS endpoint (see operations guide).
SPORTOS_WEB_ORIGIN=https://oracle.example.com
SPORTOS_API_ORIGIN=https://oracle.example.com/api
SPORTOS_COOKIE_SECURE=true
SPORTOS_GARMIN_LOCAL_FETCH_ENABLED=false
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://oracle.example.com/api/providers/strava/callback
# Copy the existing key ring exactly; do not generate replacement keys.
SPORTOS_PROVIDER_CREDENTIAL_KEYS=
SPORTOS_PROVIDER_ACTIVE_KEY_ID=
