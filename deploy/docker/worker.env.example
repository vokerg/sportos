# Prepared only. Worker startup remains blocked pending #95.
# No API, Flyway/schema-owner or legacy credentials here.
SPORTOS_WORKER_DATABASE_URL=postgresql://sportos_worker:REPLACE@PRIMARY/neondb?sslmode=require
SPORTOS_WORKER_DATA_DATABASE_URL=postgresql://sportos_worker_data:REPLACE@PRIMARY/neondb?sslmode=require
IMPORT_WORKER_CONCURRENCY=1
IMPORT_JOB_LEASE_SECONDS=60
IMPORT_JOB_POLL_MS=1000
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
SPORTOS_PROVIDER_CREDENTIAL_KEYS=
SPORTOS_PROVIDER_ACTIVE_KEY_ID=

# Optional Garmin runtime; the #95 worker-start block still applies here.
SPORTOS_GARMIN_WORKER_ENABLED=false
SPORTOS_ACTIVITY_DETAIL_WORKER_DATA_DATABASE_URL=
