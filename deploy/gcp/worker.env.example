# Root-owned /etc/sportos/worker.env, mode 0600. systemd syntax, NOT shell.
# Use the dedicated non-owner logins. Do not use API/owner/migration credentials.
SPORTOS_WORKER_DATABASE_URL=REPLACE_WITH_PRIMARY_DISPATCHER_URL
SPORTOS_WORKER_DATA_DATABASE_URL=REPLACE_WITH_PRIMARY_WORKER_DATA_URL
IMPORT_WORKER_CONCURRENCY=1
IMPORT_JOB_LEASE_SECONDS=60
IMPORT_JOB_POLL_MS=5000
# Provision this persistent path/shared backend before consuming import jobs.
SPORTOS_UPLOAD_DIR=/var/lib/sportos/uploads
SPORTOS_GARMIN_WORKER_ENABLED=false
# Required together to enable Strava:
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# SPORTOS_PROVIDER_CREDENTIAL_KEYS=
# SPORTOS_PROVIDER_ACTIVE_KEY_ID=
# Garmin additionally requires detail worker-data URL and the same encryption ring:
# SPORTOS_ACTIVITY_DETAIL_WORKER_DATA_DATABASE_URL=
# The unit supplies the per-release Python path. Do not override it here.
