[Unit]
Description=SportOS background queue worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=sportos-worker
Group=sportos-worker
WorkingDirectory=/opt/sportos/current/apps/worker
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=384
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SPORTOS_UPLOAD_DIR=/var/lib/sportos/uploads
Environment=SPORTOS_GARMIN_PYTHON=/opt/sportos/current/venv/bin/python
EnvironmentFile=/etc/sportos/worker.env
ExecStart=/usr/bin/node /opt/sportos/current/apps/worker/dist/import-worker.js
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=120
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sportos-worker
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
MemoryHigh=600M
MemoryMax=700M
MemorySwapMax=128M
CPUQuota=75%
TasksMax=64
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sportos
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
# The worker needs no VM service-account credentials. Block metadata endpoints.
IPAddressDeny=169.254.169.254/32
IPAddressDeny=fd20:ce::254/128

[Install]
WantedBy=multi-user.target
