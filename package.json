{
  "name": "sportos",
  "version": "0.0.1",
  "private": true,
  "description": "Personal sports data cockpit: spreadsheet import, deterministic scoring, and later AI analysis.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build:backend": "tsc -b apps/api apps/worker --pretty false",
    "build:api:hosted": "tsc -b apps/api --pretty false",
    "build:web:hosted": "pnpm --filter @sportos/web exec ng build --configuration hosted",
    "start:hosted": "node scripts/start-hosted.mjs",
    "test:dev-recovery": "node --test scripts/dev-supervisor.test.mjs",
    "test:hosted": "node --test scripts/start-hosted.test.mjs",
    "check:web-architecture": "node scripts/check-web-boundaries.mjs && node --test scripts/check-web-boundaries.test.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @sportos/api start:dev",
    "dev:web": "pnpm --filter @sportos/web start",
    "dev:worker": "pnpm --filter @sportos/worker dev",
    "build": "tsc -b --pretty false && pnpm --filter @sportos/web build",
    "typecheck": "tsc -b --pretty false && pnpm --filter @sportos/web typecheck",
    "test": "pnpm -r test",
    "clean": "tsc -b --clean && pnpm -r exec rm -rf dist",
    "db:migrate": "node scripts/flyway.mjs migrate",
    "db:info": "node scripts/flyway.mjs info",
    "db:info:activity-detail": "node scripts/flyway.mjs --activity-detail info",
    "db:migrate:activity-detail": "node scripts/flyway.mjs --activity-detail migrate",
    "import:local": "pnpm --filter @sportos/worker import:local",
    "garmin:setup": "node scripts/garmin-local.mjs setup",
    "garmin:login": "node scripts/garmin-local.mjs login",
    "garmin:activity": "node scripts/garmin-local.mjs activity",
    "garmin:reconcile": "pnpm --filter @sportos/db build && node scripts/garmin-reconcile-retained.mjs",
    "garmin:test": "node scripts/garmin-local.mjs test",
    "garmin:project-strength": "node scripts/garmin-project-strength.mjs",
    "strava:backfill-walks": "node scripts/strava-backfill-walks.mjs",
    "heatmap:benchmark": "pnpm exec tsx scripts/heatmap-benchmark.mts",
    "activities:project": "pnpm --filter @sportos/db build && node scripts/activity-metrics-backfill.mjs",
    "activities:efforts": "pnpm --filter @sportos/db build && node scripts/running-efforts-backfill.mjs",
    "performance:reconcile": "pnpm --filter @sportos/db build && node scripts/performance-reconcile.mjs",
    "performance:catchup": "pnpm --filter @sportos/db build && node scripts/performance-catchup.mjs",
    "activities:historical": "pnpm --filter @sportos/db build && node scripts/historical-runs.mjs",
    "dev:mobile": "pnpm --filter @sportos/mobile start",
    "typecheck:mobile": "pnpm --filter @sportos/mobile typecheck",
    "test:mobile": "pnpm --filter @sportos/mobile test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "5.8.3",
    "vitest": "^3.2.6"
  }
}
