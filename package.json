{
  "name": "sportos",
  "version": "0.0.1",
  "private": true,
  "description": "Personal sports data cockpit: spreadsheet import, deterministic scoring, and later AI analysis.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:api": "pnpm --filter @sportos/api start:dev",
    "dev:web": "pnpm --filter @sportos/web start",
    "dev:worker": "pnpm --filter @sportos/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "docker compose run --rm flyway migrate",
    "db:info": "docker compose run --rm flyway info",
    "import:local": "pnpm --filter @sportos/worker import:local"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "5.8.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "pnpm": "^11.1.3"
  }
}
