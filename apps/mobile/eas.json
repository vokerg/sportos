{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "SPORTOS_MOBILE_RELEASE": "true",
        "EXPO_PUBLIC_ALLOW_INSECURE_LOCALHOST": "false"
      }
    },
    "production": {
      "autoIncrement": false,
      "env": {
        "SPORTOS_MOBILE_RELEASE": "true",
        "EXPO_PUBLIC_ALLOW_INSECURE_LOCALHOST": "false"
      }
    }
  }
}
