# HTTPS API origin without /api; no user credentials or app secrets.
# Hosted API can be accessed via its own Render origin; never via relative Angular /api proxy.
EXPO_PUBLIC_SPORTOS_API_URL=https://api.example.com
# Exact public web login origin used to validate server-issued Safari authorization links.
EXPO_PUBLIC_SPORTOS_WEB_ORIGIN=https://sportos.example.com
# Loopback-only emulator development; never set in a release build.
EXPO_PUBLIC_ALLOW_INSECURE_LOCALHOST=false
