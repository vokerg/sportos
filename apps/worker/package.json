{
  "name": "@sportos/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/import-worker.ts",
    "start": "node dist/import-worker.js",
    "jobs": "tsx src/import-worker.ts",
    "import:local": "tsx src/import-local.ts",
    "import:dry-run": "tsx src/dry-run.ts",
    "build": "tsc -b tsconfig.json --pretty false",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run src/import-job-runner.integration.test.ts src/rule-change-runner.integration.test.ts --no-file-parallelism"
  },
  "dependencies": {
    "@sportos/db": "workspace:*",
    "@sportos/importers": "workspace:*"
  }
}
